{
  "name": "taskmanagerapp",
  "version": "1.0.0",
  "description": "A task management application that allows you to stay on top of you short and long term goals",
  "keywords": [
    "task",
    "tasks",
    "list",
    "management",
    "organisation",
    "goals",
    "todo",
    "planner",
    "productivity"
  ],
  "license": "ISC",
  "author": "Jon",
  "type": "module",
  "main": "dist/index.min.js",
  "scripts": {
    "launch": "npm run build && npm run serve",
    "build": "npm run test && npm run esbuild",
    "test": "npm run parse",
    "serve": "node server.mts",
    "esbuild": "node build.mts",
    "parse": "tsc -noEmit -p tsconfig.json"
  },
  "dependencies": {
    "express": "^5.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "esbuild": "^0.28.1",
    "typescript": "^7.0.2"
  }
}
